<div class="footer-info-grid">

  <div class="footer-column">
    {% if section.settings.footer_logo != blank %}
      {{
        section.settings.footer_logo
        | image_url: width: 300
        | image_tag: alt: 'Footer Logo'
      }}
    {% endif %}

    <div class="footer-column-logo-content">
      {{ section.settings.guarantee_text }}
    </div>
  </div>

  <div class="footer-column">
    <div class="footer-column-heading">
      {{ section.settings.heading1 }}
    </div>

    <div class="footer-column-content">
      {% for i in (1..4) %}
        {% assign text_key = 'shop_link_' | append: i | append: '_text' %}
        {% assign url_key = 'shop_link_' | append: i | append: '_url' %}
    
        {% assign text = section.settings[text_key] %}
        {% assign url = section.settings[url_key] %}
    
        {% if text != blank %}
          <span>
            <a href="{{ url }}">{{ text }}</a>
          </span>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="footer-column">
    <div class="footer-column-heading">
      {{ section.settings.heading2 }}
    </div>

    <div class="footer-column-content">
      {% for i in (1..4) %}
        {% assign text_key = 'help_link_' | append: i | append: '_text' %}
        {% assign url_key = 'help_link_' | append: i | append: '_url' %}
    
        {% assign text = section.settings[text_key] %}
        {% assign url = section.settings[url_key] %}
    
        {% if text != blank %}
          <span>
            <a href="{{ url }}">{{ text }}</a>
          </span>
        {% endif %}
      {% endfor %}
    </div>

  </div>


  <div class="footer-column">
    <div class="footer-column-heading">
      {{ section.settings.heading3 }}
    </div>
    <div class="footer-column-content">
      <span><a href="{{ section.settings.instagram_url }}">Instagram</a></span>
      <span><a href="{{ section.settings.facebook_url }}">Facebook</a></span>
      <span><a href="{{ section.settings.youtube_url }}">YouTube</a></span>
      <span><a href="{{ section.settings.tiktok_url }}">TikTok</a></span>
    </div>
  </div>

  
  <!-- Contact -->
  <div class="footer-column">

    <h3>
      {{ section.settings.contact_heading }}
    </h3>

    <div class="rte">
      {{ section.settings.contact_text }}
    </div>

  </div>

</div>