{% liquid
    assign tabs = ''
  
    if product.metafields.custom.benefit_outcome != blank
      assign tabs = tabs | append: 'Key Benefits|custom.benefit_outcome,'
    endif
  
    if product.metafields.custom.how_to_use != blank
      assign tabs = tabs | append: 'How to Use|custom.how_to_use,'
    endif
  
    if product.metafields.custom.key_ingredients != blank
      assign tabs = tabs | append: 'Key Ingredients|custom.key_ingredients,'
    endif
  
    assign tabs = tabs | split: ','
  %}
  
  {% if tabs.size > 0 %}
  <div class="product-description-tabs">
  
          {% for tab in tabs %}
              {% unless tab == blank %}
                  {% assign item = tab | split: "|" %}
  
                  <div class="resp-tab-content">
  
                      {% case item[1] %}
  
                          {% when 'custom.benefit_outcome' %}
                                <button class="benefit_outcome">
                                <span>Key benefits</span>
                                <span class="tab-benefits-plus-icon tab-plus-icon">
                                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path class="vertical" d="M2.75 7H11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                    <path class="horizontal" d="M7 2.75L7 11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                    </svg>
                                </span>
                                <span class="tab-benefits-minus-icon tab-minus-icon">
                                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M2.75 7H11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                    </svg>
                                </span>  
                            </button>
                            <span class="tab-benefits-detail tab-info"> 
                                {{ product.metafields.custom.benefit_outcome | metafield_tag }}
                            </span>
                          {% when 'custom.how_to_use' %}
                                <button class="how_to_use">
                                <span>How to use</span>
                                <span class="tab-howtouse-plus-icon tab-plus-icon">
                                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path class="vertical" d="M2.75 7H11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                    <path class="horizontal" d="M7 2.75L7 11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                    </svg>
                                </span>
                                <span class="tab-howtouse-minus-icon tab-minus-icon">
                                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M2.75 7H11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                    </svg>
                                </span>  
                            </button>
                            <span class="tab-howtouse-detail tab-info">
                                {{ product.metafields.custom.how_to_use | metafield_tag }}
                            </span>    
                          {% when 'custom.key_ingredients' %}
                                <button class="key_ingredients">
                                    <span>Key ingredients</span>
                                    <span class="tab-keying-plus-icon tab-plus-icon">
                                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path class="vertical" d="M2.75 7H11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                        <path class="horizontal" d="M7 2.75L7 11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                        </svg>
                                    </span>
                                    <span class="tab-keying-minus-icon tab-minus-icon">
                                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M2.75 7H11.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round"></path>
                                        </svg>
                                    </span>  
                                </button>
                                <span class="tab-keying-detail tab-info">
                                {{ product.metafields.custom.key_ingredients | metafield_tag }}
                                </span>
  
                      {% endcase %}
  
                  </div>
  
              {% endunless %}
          {% endfor %}
  
      
  </div>
  {% endif %}
<div class="instock-tab">
    <span><svg xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
     <path d="M5 12l5 5L20 7" />
   </svg></span>
    <span>In stock — usually ships within 24 hours.</span>
</div>