<div class="collection-card-group">
    <!-- Colleciton Loop-->
    {% for item in items %}
        {% assign parts = item | split: "|" %}
        {% assign handle = parts[0] | strip %}
        {% assign title = parts[1] | strip %}
        {% assign desc = parts[2] | strip %}
        {% assign collection = collections[handle] %}
    
        {% if collection %}    
        <div class="collection-card">
        <div class="img-section">
            {% if collection.featured_image != blank %}
            <img
                src="{{ collection.featured_image | image_url: width: 300 }}"
                alt="{{ title }}"
                width="300"
                height="300"
                loading="lazy"
              >
            {% else %}
                <img
                    src="{{ 'ProductPhotos006MangoParfait.avif' | asset_url }}"
                    alt="Category"
                    width="400"
                    height="300"
                  >
            {% endif %}
        </div>
        <div class="collection-info">
            <div class="collection-info-details">
            <h3><a href="{{ collection.url }}">{{title}}</a></h3>
            <p>{{desc}}</p>
            <span>{{ collection.products_count }} 
                {% if collection.products_count == 1 %}
                    Product
                  {% else %}
                    Products
                  {% endif %}
            </span>
            </div>
            <div>
            <a href="{{ collection.url }}">    
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
            >
                <path
                d="M5 12H18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                />
                <path
                d="M13 7L18 12L13 17"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                />
            </svg>
            </a>
            </div>
        </div>
        </div>
        {% endif %}
    {% endfor %}

  </div>