<div class="home-collection-list">
  <div class="home-collection-list__content">
      <h2>{{ section.settings.title }}</h2>
      <div class="eyebrow-text">{{ section.settings.sub-title }}</div>
  </div>
  <div class="home-collections">
  {% for block in section.blocks %}
    <div class="home-collection">
    {% assign collection = block.settings.collection_id %}
        <a href="{{ collection.url }}">
            {% if block.settings.image %}
                <div class="collection-image">
                {{ block.settings.image | image_url: width: 600 | image_tag }}
                </div>
            {% endif %}
            <div class="home-collection-info">
                <h3>{{ collection.title }}</h3>
                <div class="desc">
                  {{  collection.products_count }}
                  {% if collection.products_count == 1 %}
                    Product
                  {% else %}
                      Products
                  {% endif %}
                </div>
            </div>
        </a>
     </div>    
  {% endfor %}
  </div> 
</div> 
{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "sub-title",
      "label": "Sub Title",
      "default": "Explore products based on your needs"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection_id",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Collection",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "collection_id": "moisture-matters"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection_id": "repair-restore"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection_id": "soothe-calm"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection_id": "confident-coils"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection_id": "skin-care"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection_id": "eyes"
          }
        }
      ]
    }
  ]
}
{% endschema %}