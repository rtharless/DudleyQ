    <div class="product-footer-badges">
        <div class="badge-col">
            {%  if section.settings.image1 %}
                {{ section.settings.image1
                    | image_url: width: 24
                    | image_tag
                }}
            {% endif %}
            <span>{{ section.settings.trust-title1}}</span>
        </div>
        <div class="badge-col">
            {{ section.settings.image2
                | image_url: width: 24
                | image_tag
            }}
            <span>{{ section.settings.trust-title2}}</span>
        </div>
        <div class="badge-col">
            {{ section.settings.image3
                | image_url: width: 24
                | image_tag
            }}
            <span>{{ section.settings.trust-title3}}</span>
        </div>
        <div class="badge-col">
            {{ section.settings.image4
                | image_url: width: 24
                | image_tag
            }}
            <span>{{ section.settings.trust-title4}}</span>
        </div>
    </div>

{% schema %}
{
    "name": "Product Trust Row",
    "settings": [
        {
            "type": "image_picker",
            "id": "image1",
            "label": "First Block"
        },
        {
            "type": "text",
            "id": "trust-title1",
            "label": "trust Title 1",
            "default": "Cruelty-free"
        },
        {
            "type": "image_picker",
            "id": "image2",
            "label": "Second Block"
        },
        {
            "type": "text",
            "id": "trust-title2",
            "label": "trust Title 2",
            "default": "Sulfate-free"
        },
        {
            "type": "image_picker",
            "id": "image3",
            "label": "First Block"
        },
        {
            "type": "text",
            "id": "trust-title3",
            "label": "trust Title 3",
            "default": "Vegan formula"
        },
        {
            "type": "image_picker",
            "id": "image4",
            "label": "First Block"
        },
        {
            "type": "text",
            "id": "trust-title4",
            "label": "trust Title 4",
            "default": "Ships in 24 hrs"
        },
    ]
}
{% endschema %}