{%- comment -%}
  Trust bar. By default each badge uses the built-in brand line icon (snippets/trust-icon),
  so the old screenshot images are ignored. Untick "Use brand icons" to fall back to the
  image pickers.
{%- endcomment -%}
{%- assign icon_names = 'salon,cruelty-free,sulfate-free,black-owned' | split: ',' -%}
<div class="section section--page-width">
    <div class="product-footer-badges">
        {%- for name in icon_names -%}
            {%- assign i = forloop.index | append: '' -%}
            {%- assign image_key = 'image' | append: i -%}
            {%- assign title_key = 'trust-title' | append: i -%}
            {%- assign badge_image = section.settings[image_key] -%}
            <div class="badge-col">
                {%- if section.settings.use_brand_icons -%}
                    {%- render 'trust-icon', icon: name -%}
                {%- elsif badge_image -%}
                    {{ badge_image | image_url: width: 96 | image_tag: width: 24, height: 24, alt: '' }}
                {%- endif -%}
                <span>{{ section.settings[title_key] }}</span>
            </div>
        {%- endfor -%}
    </div>
</div>
{% schema %}
{
    "name": "Product Trust Row",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_brand_icons",
            "label": "Use brand icons",
            "info": "Shows the built-in Dudley line icons. Untick to use the images below instead.",
            "default": true
        },
        {
            "type": "image_picker",
            "id": "image1",
            "label": "First Block"
        },
        {
            "type": "text",
            "id": "trust-title1",
            "label": "trust Title 1",
            "default": "Salon formulated"
        },
        {
            "type": "image_picker",
            "id": "image2",
            "label": "Second Block"
        },
        {
            "type": "text",
            "id": "trust-title2",
            "label": "trust Title 2",
            "default": "Cruelty-free"
        },
        {
            "type": "image_picker",
            "id": "image3",
            "label": "First Block"
        },
        {
            "type": "text",
            "id": "trust-title3",
            "label": "trust Title 3",
            "default": "Sulfate-free Options"
        },
        {
            "type": "image_picker",
            "id": "image4",
            "label": "First Block"
        },
        {
            "type": "text",
            "id": "trust-title4",
            "label": "trust Title 4",
            "default": "BLACK OWNED"
        }
    ]
}
{% endschema %}