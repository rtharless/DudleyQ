                }
            },
            {
                "type": "color-story",
                "settings": {
                    "collection": "foundations"
                }
            },
            {
                "type": "routine",
                "settings": {
                    "title": "Classics",
                    "filter_value":"Classics"
                }
            },
            {
                "type": "routine",
                "settings": {
                    "title": "Confident Curls",
                    "filter_value":"Confident Curls"
                }
            },
            {
                "type": "routine",
                "settings": {
                "title": "Healthy Tresses",
                "filter_value":"Healthy Tresses"
                }
            },
            {
                "type": "routine",
                "settings": {
