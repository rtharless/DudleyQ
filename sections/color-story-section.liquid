<section class="color-story section">
    <div class="color-story-detail">
        <div class="color-story-image">
            {% if section.settings.image %}
                {{ section.settings.image | image_url: width: 600 | image_tag }}
            {% endif %}
        </div>
        <div class="color-story-info">
            <span class="eyebrow-text">{{ section.settings.eyebrow-heading }}</span>
            <h2>{{ section.settings.title }}</h2>
            {{ section.settings.description }}
            <div class="color-story-collection-grid">
                {% for block in section.blocks %}
                    {% if block.type == 'color-story' %}
                    {% assign collection = block.settings.collection %}
                    <a>
                    {% if block.settings.image %}
                        <div class="collection-image">
                        {{ block.settings.image | image_url: width: 600 | image_tag }}
                        </div>
                    {% endif %}
                    <div class="collection-title">
                        {{ collection.title }}
                    </div>
                    <div class="product-count">
                        {{ collection.products_count }}
                        {% if collection.products_count == 1 %}
                            Product
                        {% else %}
                            Products
                        {% endif %}
                    </div>
                    </a>
                    {% endif %}
                {% endfor %}    
            </div>
            <a class="shop-cosmetic" href="">{{ section.settings.button_label }}</a>
        </div>
    </div>
    <div class="full-routine">
        <div class="heading">
            <h2>{{ section.settings.full-routine }}</h2>
            <span class="count">{{ section.settings.routine-count }}</span>
        </div>
        <div class="routine-cards">
            {% for block in section.blocks %}
                {% if block.type == 'routine' %}
                    <a href="{{ routes.all_products_collection_url }}?filter.p.m.custom.routine={{ block.settings.filter_value | url_encode | replace: '+', '%20' }}"><span class="title">{{ block.settings.title }}</span></a>
                {% endif %}
            {% endfor %} 
        </div>
    </div>
</section>
  
  {% schema %}
  {
    "name": "Color Story Section",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "eyebrow-heading",
        "label": "Eyebrow Heading",
        "default": "Cosmetics"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "The color story"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default":"<p>Seventy-five products across lips, eyes, blushers and foundations, matched to deep and rich skin tones rather than filtered down from someone else's palette.</p>"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "Shop Cosmetics"
      },
      {
        "type": "text",
        "id": "full-routine",
        "label": "Full Routine Heading",
        "default": "Or build a full routine"
      },
      {
        "type": "text",
        "id": "routine-count",
        "label": "Routine Count",
        "default": "Seven routines"
      },
    ],
    "blocks": [
        {
            "type": "color-story",
            "name": "Color Story",
            "settings":[
                {
                    "type": "collection",
                    "id": "collection",
                    "label": "Collection"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
            ]
        },
        {
            "type": "routine",
            "name": "Routines",
            "settings":[
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },
                {
                    "type": "text",
                    "id": "filter_value",
                    "label": "Filter Value"
                },
            ]
        }
    ],
    "max_blocks": 20,
    "presets": [
        {
        "name": "Color Story Section",
        "blocks": [
