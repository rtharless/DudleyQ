{{ 'concern-page.css' | asset_url | stylesheet_tag }}

<div class="routine-concern-page">

    <div class="routine-concern-page__content">
      <div class="step1" id="step1">
        <h1>
            {{ section.settings.title }}
        </h1>

        <div class="routine-concern-buttons">
          {% for block in section.blocks %}
            {% if block.type == 'routine_finder' %}
              <a data-value="{{ block.settings.filter_value }}" href="javascript:void(0);"
                  class="routine-concern-button"
                  data-index="{{ forloop.index0 }}">

                    {% if block.settings.card_image %}
                        {{ block.settings.card_image | image_url: width: 600 | image_tag }}
                        <span>{{ block.settings.title }}</span>
                    {% else %}
                      {{ block.settings.title }}    
                    {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>

      </div>

      <div class="step2" id="step2">
        <h1>
            {{ section.settings.title2 }}
        </h1>

        <div class="routine-concern-buttons">
          {% for block in section.blocks %}
            {% if block.type == 'routine_finder-concern' %}
              <a data-value="{{ block.settings.filter_value }}" href="javascript:void(0);" class="routine-concern-button" data-index="{{ forloop.index0 }}">

                    {% if block.settings.card_image %}
                        {{ block.settings.card_image | image_url: width: 600 | image_tag }}
                        <span>{{ block.settings.title }}</span>
                    {% else %}
                      {{ block.settings.title }}    
                    {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>

      </div>

      <div class="finalstep" id="finalstep">
        <h1>
            {{ section.settings.final_title }}
        </h1>
  
        <div class="routine-concern-buttons">
              <a href="javascript:void(0);" class="routine-concern-button">
                <div class="result-div">
                  <span class="result-title">HAIR TYPE</span>
                  <span id="hair_type"></span>
                </div>
              </a>
              <a href="javascript:void(0);" class="routine-concern-button">
                <div class="result-div">
                  <span class="result-title">HAIR CONCERN</span> 
                  <span id="hair_concern"></span>
                </div>
          </a>
        </div>
        <div class="result-text"> On basis of your selection, Routine is: <span id="routine-value"><strong>Routine Name</strong></span> </div>

        <div class="final-button-group">
          <button class="submit-btn button" id="routine-button" data-url="">{{  section.settings.button_label}}</button>
          <a href="{{ shop.root_url }}routine-finder" class="start-link">{{ section.settings.statr_over_link }}</a>
        </div>
      </div>


  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
  
    const firstDiv = document.getElementById('step1');
    const secondDiv = document.getElementById('step2');
    const finalDiv = document.getElementById('finalstep');
    
    {% render 'routine-map' %}

    document.querySelectorAll('#step1 .routine-concern-button').forEach(function (link) {
  
      link.addEventListener('click', function (event) {
        event.preventDefault();
        const value = this.dataset.value;
        sessionStorage.setItem('selectedOption1', value);
        firstDiv.style.display = 'none';
        secondDiv.style.display = 'block';
        
        setTimeout(function () {
          const routinePage = document.querySelector('.announcement-bar__slider');
        
          if (routinePage) {
            routinePage.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        }, 100);
      });
  
    });

    document.querySelectorAll('#step2 .routine-concern-button').forEach(function (link) {
  
      link.addEventListener('click', function (event) {
        event.preventDefault();
        const value = this.dataset.value;

        const hairType = sessionStorage.getItem('selectedOption1');
        const concern = value;

        // Get recommended routine
        const routine = getRoutine(hairType, concern);
        
        secondDiv.style.display = 'none';
        document.getElementById('hair_type').textContent = hairType;
        document.getElementById('hair_concern').textContent = value;
        document.getElementById('routine-value').innerHTML = `<strong>${routine}</strong>`;
        
        const routineUrl =
          "{{ routes.root_url }}collections/all?filter.p.m.custom.routine=" +
          encodeURIComponent(routine);

        document.getElementById('routine-button').setAttribute('data-url', routineUrl);
        
        finalDiv.style.display = 'block';
        setTimeout(function () {
          const routinePage = document.querySelector('.announcement-bar__slider');
        
          if (routinePage) {
            routinePage.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        }, 100);
      });
    });

    document.getElementById('routine-button').addEventListener('click', function () {
      window.location.href = this.dataset.url;
    });

  });
  </script>

