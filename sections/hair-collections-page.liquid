{{ 'hair-coolections-page.css' | asset_url | stylesheet_tag }}

<div class="hair-coolections-page">

  {% if section.settings.image %}
    <div class="hair-coolections-page__image">
        
            {{ section.settings.image | image_url: width: 600 | image_tag }}
        
    </div>
  {% endif %}
    <div class="hair-coolections-page__content">

        <h2>
          {{ section.settings.heading }}
        </h2>

        <div class="hair-coolections-buttons">
            {% for block in section.blocks %}
                <a href="{{routes.collections_url}}/{{ block.settings.url }}"
                    class="hair-coolections-button"
                    data-index="{{ forloop.index0 }}">

                      {% if block.settings.card_image %}
                          {{ block.settings.card_image | image_url: width: 600 | image_tag }}
                          <span>{{ block.settings.title }}</span>
                      {% else %}
                        {{ block.settings.title }}    
                      {% endif %}
                </a>
            {% endfor %}
        </div>
    </div>

</div>

{% schema %}
{
  "name": "Hair Collections Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hair Collections"
    }
  ],
  "blocks": [
    {
      "type": "hair-collections",
      "name": "Hair Collections",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "url",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Hair Collections Page",
      "blocks": [
        {
          "type": "hair-collections",
          "settings": {
            "title": "Moisture Matters"
          }
        },
        {
          "type": "hair-collections",
          "settings": {
            "title": "Confident Curls"
          }
        },
        {
          "type": "hair-collections",
          "settings": {
            "title": "Soothe & Calm"
          }
        },
        {
          "type": "hair-collections",
          "settings": {
            "title": "Repair & Restore"
          }
        },
        {
          "type": "hair-collections",
          "settings": {
            "title": "Healthy Hair"
          }
        },
        {
          "type": "hair-collections",
          "settings": {
            "title": "Camille's Choice"
          }
        }
      ]
    }
  ]
}
{% endschema %}